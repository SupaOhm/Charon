    },
    {
      "id": "E03",
      "title": "Old Feud",
      "condition": "Tartarus: both opposing soldiers of one cohort were aboard on entry, even if either disembarked here.",
      "effect": "Optional: pay 1 obol to reconcile only this pair for the run. Remove their conflict pressure on later crossings. Decline: no effect.",
      "flavor": "An old argument reaches a moment of quiet.",
      "optional": true,
      "source_trigger": "Arrive at Tartarus with both same-cohort soldiers aboard on entry, even if one disembarks here",
